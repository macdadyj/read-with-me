# Copy to .env for local development.
# Existing project — do not create a new one.
GCP_PROJECT_ID=montano-349204
REGION=us-central1
GCP_LOCATION=us-central1
# Speech-to-Text v2 recognizers live in the multi-region "us" location.
SPEECH_LOCATION=us

# Cloud Run runtime identity (deploy with --service-account).
CLOUD_RUN_SERVICE_ACCOUNT=read-with-me@montano-349204.iam.gserviceaccount.com

# Optional Document AI processor. If unset, Vision DOCUMENT_TEXT_DETECTION is used.
DOCUMENT_AI_PROCESSOR=

# Session bucket on montano-349204. Unused unless SAVE_SESSION=true
# (off by default — child audio is not kept).
GCS_BUCKET=gs://montano-349204-read-with-me
SAVE_SESSION=false

# Force mocks even if ADC is present. Useful for UI work.
USE_MOCK_GCP=false

# Warm, clear neural voice. Chirp 3 HD names also work if enabled on the project.
TTS_VOICE=en-US-Neural2-F

# Vertex model for hints + OCR cleanup (us-central1).
GEMINI_MODEL=gemini-2.0-flash

PORT=8080
