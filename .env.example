# Copy to .env for local development. Leave PROJECT_ID as your GCP project.
GCP_PROJECT=
GCP_LOCATION=us-central1
# Speech-to-Text v2 recognizers often live in the multi-region "us" location.
SPEECH_LOCATION=us

# Optional Document AI processor. If unset, Vision DOCUMENT_TEXT_DETECTION is used.
DOCUMENT_AI_PROCESSOR=

# Optional. Only used when SAVE_SESSION=true (off by default — child audio is not kept).
GCS_BUCKET=
SAVE_SESSION=false

# Force mocks even if ADC is present. Useful for UI work.
USE_MOCK_GCP=false

# Warm, clear neural voice. Chirp 3 HD names also work if enabled on the project.
TTS_VOICE=en-US-Neural2-F

# Vertex model for hints + OCR cleanup.
GEMINI_MODEL=gemini-2.0-flash

PORT=8080
